# ================================================================
# WAPPA — ENVIRONMENT VARIABLE NAMING POLICY
# ================================================================
#
# Unprefixed platform contracts : PORT, DATABASE_URL, REDIS_URL
# Framework runtime settings    : SYSTEM_*
# Meta / WhatsApp transport     : META_*, WP_*
# AI vendor services            : OPENAI_*, ANTHROPIC_*
# Storage vendor services       : SUPABASE_*
# App-specific namespaces       : your own prefix (e.g. MIIA_*, BELLABELLA_*)
# ================================================================

# ── Platform ────────────────────────────────────────────────────
PORT=8000

# ── Framework (SYSTEM_*) ────────────────────────────────────────
# Values: DEV | PROD
SYSTEM_ENVIRONMENT=DEV
# Values: DEBUG | INFO | WARNING | ERROR
SYSTEM_LOG_LEVEL=DEBUG
SYSTEM_LOG_DIR=./logs
SYSTEM_TIME_ZONE=UTC

# ── Meta Application Configuration (one Meta App per Wappa app) ───
#
# Callback URL (one per Meta App, for any number of Inboxes):
#
#     GET  https://your-domain.com/webhook/inboxes/whatsapp
#     POST https://your-domain.com/webhook/inboxes/whatsapp
#
# Both values below are REQUIRED whenever the WhatsApp callback is mounted,
# in every environment. There is no development bypass.
#
#   META_APP_SECRET          Meta App Secret. Wappa verifies the exact POST
#                            body bytes against X-Hub-Signature-256 before it
#                            parses JSON, reads the Inbox Directory, or
#                            schedules any work. Missing or bad signatures
#                            answer a generic 401.
#   WP_WEBHOOK_VERIFY_TOKEN  Value you choose for Meta's GET challenge. It is
#                            used ONLY for the GET handshake, never as an HMAC
#                            secret.
#
# The Inbox is derived from the authenticated POST payload
# (value.metadata.phone_number_id, or a flat value.phone_number_id), never
# from the URL and never from these variables. A phone-scoped change must
# also belong to the WABA in entry[].id, or the whole batch is rejected (400).
# The older /webhook/inboxes/{inbox_id}/whatsapp route returns 404.
META_APP_SECRET=
WP_WEBHOOK_VERIFY_TOKEN=

# Optional. Defaults to the version and base URL Wappa ships with.
META_API_VERSION=v26.0
# META_BASE_URL=https://graph.facebook.com/

# ── Inbox Routing Mode ──────────────────────────────────────────
#
# Wappa has exactly two modes. They never fall back to each other, and a
# mixed configuration fails startup with a direct message.
#
#   legacy   (default)  One WhatsApp Inbox from the complete bundle below.
#                       WP_PHONE_ID is the single Inbox and the default for
#                       Wappa's /api/whatsapp/* routes when X-Wappa-Inbox-ID
#                       is absent. Registering an IInboxDirectorySource in
#                       legacy mode is an error.
#
#   explicit            Many Inboxes through Wappa's encrypted Inbox
#                       Directory. Requires Wappa(inbox_routing="explicit"),
#                       an IInboxDirectorySource, and SYSTEM_TOKEN_ENC_KEY.
#                       Any of WP_ACCESS_TOKEN / WP_PHONE_ID / WP_BID present
#                       in the process environment fails startup. There is no
#                       default Inbox: every Inbox-dependent /api/whatsapp/*
#                       call must send X-Wappa-Inbox-ID (selection only — it
#                       is not a credential and grants no permission).
#
# Select the mode in code (Wappa(inbox_routing=...)) or here:
# SYSTEM_INBOX_ROUTING_MODE=legacy

# ── Legacy mode bundle (legacy mode ONLY; set all three or none) ──
# WP_ACCESS_TOKEN stays a legacy single-Inbox input. It is not renamed to
# META_ACCESS_TOKEN because Meta does not promise one credential for every
# Meta product; explicit mode stores one encrypted bearer token per Inbox.
WP_ACCESS_TOKEN=
WP_PHONE_ID=
WP_BID=

# ── Explicit mode encryption (explicit mode ONLY) ─────────────────
# Fernet key that encrypts every Inbox credential Wappa stores or caches.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing every accepted key makes stored credentials unrecoverable.
# SYSTEM_TOKEN_ENC_KEY=
# Optional, ordered, comma-separated older keys kept only during rotation.
# SYSTEM_TOKEN_ENC_PREVIOUS_KEYS=

# See: CONTEXT.md (Inbox Reference, Inbox Directory, Inbox Routing Mode)
#      ARCHITECTURE.md (authenticated intake, Inbox Execution Context)
#      docs/public-contract.md (records, commands, header matrix, errors)
#      docs/migration/v0.27.0-multi-inbox.md (legacy and explicit Host guides)
#      docs/adr/0010-payload-routed-whatsapp-webhook.md
#      docs/adr/0011-encrypted-inbox-directory.md

# ── Persistence ─────────────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db
# REDIS_URL=redis://localhost:6379/
# REDIS_MAX_CONNECTIONS=64

# ── AI ──────────────────────────────────────────────────────────
# OPENAI_API_KEY=
