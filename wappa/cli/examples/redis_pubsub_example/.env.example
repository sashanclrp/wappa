# ================================================================
# WAPPA — ENVIRONMENT VARIABLE NAMING POLICY
# ================================================================
#
# Unprefixed platform contracts : PORT, DATABASE_URL, REDIS_URL
# Framework runtime settings    : SYSTEM_*
# Meta transport               : META_*
# Host provider configuration   : LLM_PROVIDER_*
# Redis configuration           : REDIS_*
# Host-owned settings           : a cluster owned by the Host Application
# ================================================================

# ── Platform ────────────────────────────────────────────────────
PORT=8000

# ── Framework (SYSTEM_*) ────────────────────────────────────────
SYSTEM_ENVIRONMENT=DEV
SYSTEM_LOG_LEVEL=DEBUG
SYSTEM_LOG_DIR=./logs
SYSTEM_TIME_ZONE=UTC

# ── Meta Application Configuration (required with the callback) ──
# App Secret: authenticates every POST callback body (no dev bypass).
META_APP_SECRET=
# Chosen value for Meta's GET challenge only; never an HMAC secret.
META_WEBHOOK_VERIFY_TOKEN=
META_API_VERSION=v26.0

# ── Inbox Routing Mode: legacy (this example) ───────────────────
# One WhatsApp Inbox from the complete bundle (set all three). For many
# Inboxes under one Meta App use explicit mode instead — see
# docs/migration/v0.27.0-multi-inbox.md. The two modes never mix.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── Persistence (required for PubSub) ───────────────────────────
REDIS_URL=redis://localhost:6379/
REDIS_MAX_CONNECTIONS=64

# ── AI (uncomment to enable) ────────────────────────────────────
# LLM_PROVIDER_OPENAI_API_KEY=
