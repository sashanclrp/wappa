# Meta Application Configuration — required when the WhatsApp callback is mounted.
META_APP_SECRET=
WP_WEBHOOK_VERIFY_TOKEN=

# Explicit Inbox Directory mode: Wappa obtains every Inbox from the Host-owned
# source adapter. Never set WP_ACCESS_TOKEN, WP_PHONE_ID, or WP_BID here.
SYSTEM_INBOX_ROUTING_MODE=explicit
# Generate once with: CredentialCodec.generate_key()
SYSTEM_TOKEN_ENC_KEY=

# Configure the callback URL in the Meta App:
#   https://your-domain.com/webhook/inboxes/whatsapp
