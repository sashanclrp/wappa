# WhatsApp Business API Configuration

# General Configuration
PORT=8000
SYSTEM_TIME_ZONE=America/Bogota

# DEBUG or INFO or WARNING or ERROR
SYSTEM_LOG_LEVEL=INFO
SYSTEM_LOG_DIR=./logs

## Environment DEV or PROD
SYSTEM_ENVIRONMENT=DEV

# WhatsApp Graph API
META_BASE_URL=https://graph.facebook.com/
META_API_VERSION=v26.0

# ==========================================
# Meta Application Configuration (required)
# ==========================================
# One Meta App per Wappa application. Both values are required whenever the
# WhatsApp callback is mounted, in every environment (no development bypass).
#
# META_APP_SECRET: the App Secret from the Meta App dashboard. Wappa verifies
# every POST callback body against X-Hub-Signature-256 before parsing it.
META_APP_SECRET=

# WP_WEBHOOK_VERIFY_TOKEN: a value you choose; used only for Meta's GET
# challenge, never as an HMAC secret.
WP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# Configure this one callback URL in the Meta App:
#   https://your-domain.com/webhook/inboxes/whatsapp

# ==========================================
# Inbox Routing Mode: legacy (this template)
# ==========================================
# This project runs the default `legacy` mode: one WhatsApp Inbox from the
# complete bundle below (set all three). WP_PHONE_ID is the Inbox and the
# default for Wappa's /api/whatsapp/* routes.
#
# For many Inboxes under one Meta App, use `explicit` mode instead:
# Wappa(inbox_routing="explicit", inbox_directory_source=YourSource()),
# set SYSTEM_TOKEN_ENC_KEY, and remove the three WP_* values below. See
# docs/migration/v0.27.0-multi-inbox.md. The two modes never mix.

# WhatsApp Access Token (legacy mode)
WP_ACCESS_TOKEN=

# WhatsApp Phone Number ID (legacy mode) — this is the Inbox ID
WP_PHONE_ID=

# WhatsApp Business Account ID / WABA (legacy mode)
WP_BID=

# ==========================================
# BSUID Support (v24.0+)
# ==========================================
# WhatsApp API v24.0+ introduces Business-Scoped User IDs (BSUIDs) for stable user identification.
#
# What is a BSUID?
# - Format: "user.9373795779eb6..." (stable identifier that doesn't change)
# - Replaces phone numbers for users who enable WhatsApp usernames
# - Remains consistent even if user changes phone number
#
# Webhook Changes:
# 1. Incoming Messages:
#    - "from_user_id": Contains BSUID when available
#    - "from": May be EMPTY for username-only users (when business hasn't messaged
#              user's phone in last 30 days OR user hasn't added business to contacts)
#
# 2. Status Updates:
#    - "recipient_user_id": Contains BSUID when message was sent to BSUID
#    - "recipient_id": May be EMPTY for BSUID-only users (same conditions as above)
#
# 3. User Profiles:
#    - "username": WhatsApp username (e.g., "@johndoe")
#    - "country_code": User's country code
#
# Send Message Responses:
# - "contacts[].user_id": BSUID if sent to BSUID
# - "contacts[].wa_id": EMPTY if sent to BSUID
# - "contacts[].input": Returns what you sent (BSUID or phone number)
#
# Important Limitations:
# - Error Code 131062: Authentication messages (OTPs, verification codes) can ONLY
#                      be sent to phone numbers, NOT BSUIDs
#
# Developer Guidance:
# - Use webhook.user.user_id property (returns BSUID if available, else phone)
# - Use webhook.recipient_id property for status updates (BSUID preferred)
# - Your code automatically handles BSUID vs phone number scenarios
# ==========================================

# Redis Configuration (Optional - uncomment to enable Redis persistence)
REDIS_URL=redis://localhost:6379/
REDIS_MAX_CONNECTIONS=64

# Optional: AI Tools
OPENAI_API_KEY=
