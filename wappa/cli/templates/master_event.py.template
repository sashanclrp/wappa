from wappa.domain.inbox import InboxRef
from wappa.messaging import DirectMessage
from wappa import WappaEventHandler
from wappa.webhooks import InboundMessageWebhook

class MasterEventHandler(WappaEventHandler):
    
    async def process_message(self, webhook: InboundMessageWebhook):
        await self.messenger.mark_as_read(webhook.message.message_id)
        await self.messenger.send_text("Wappa App ready", DirectMessage(inbox_ref=InboxRef(platform=self.messenger.platform, inbox_id=self.messenger.inbox_id), recipient_id=webhook.user.user_id))